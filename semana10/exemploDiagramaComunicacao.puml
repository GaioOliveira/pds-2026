@startuml
skinparam object {
    BackgroundColor White
    BorderColor #8B4513
    ArrowColor #A0522D
}

' Definindo os Objetos
object "<u>:Cliente</u>" as cliente
object "<u>:TelaTotem</u>" as tela
object "<u>:ControladorPedido</u>" as controle
object "<u>:Cardapio</u>" as cardapio
object "<u>:Pedido</u>" as pedido
object "<u>:Barista</u>" as barista

' Desenhando os Links e Mensagens
cliente -right-> tela : 1: fazerPedido(listaDeItens) >
tela -down-> controle : 1.1: processarPedido(listaDeItens) >

' O loop de consulta
controle -left-> cardapio : 1.1.1 *[para cada item]: preco = buscarPreco(item) >

' O loop de inserção + O fechamento (na mesma linha de conexão)
controle -down-> pedido : 1.1.2 *[para cada item]: adicionarItem(item, preco) > \n 1.1.3: fecharPedido() >

' Notificação final
controle -right-> barista : 1.1.4: notificarPreparo(idPedido) >

@enduml
